load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")
load("//:repo_files.bzl", "REPO_FILE_EXCLUDES")
load(":linters.bzl", "golangci_lint_test")

repo_files(exclude = REPO_FILE_EXCLUDES)

repo_files(
    name = "okf_repo_files",
    exclude = REPO_FILE_EXCLUDES,
)

go_library(
    name = "dispatch",
    srcs = ["dispatch.go"],
    importpath = "go.tbhb.dev/tools/internal/dispatch",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "dispatch_test",
    size = "small",
    srcs = ["dispatch_test.go"],
    embed = [":dispatch"],
    tags = ["unit"],
    visibility = ["//:__pkg__"],
)

golangci_lint_test(
    name = "depguard_test",
    size = "small",
    srcs = [":dispatch_test"],
)
