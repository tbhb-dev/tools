load("@rules_go//go:def.bzl", "go_binary", "go_library")

filegroup(
    name = "repo_files",
    srcs = [
        "BUILD.bazel",
        "main.go",
    ],
    visibility = ["//:__pkg__"],
)

go_binary(
    name = "tbhbdev",
    embed = [":tbhbdev_lib"],
    visibility = ["//:__pkg__"],
    x_defs = {"main.bundleVersion": "{STABLE_BUILD_SCM_VERSION}"},
)

go_library(
    name = "tbhbdev_lib",
    srcs = ["main.go"],
    importpath = "go.tbhb.dev/tools/cmd/tbhbdev",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/dispatch",
        "//internal/plugins",
    ],
)
