# Directories that hold no source of this repository: VCS metadata, Python
# environments, tool caches, agent worktrees, scratch, the side-repo clones
# under tmp/ and Obsidian's vault settings. Ignoring them keeps them out of
# every package and every glob, so the whole-tree checks (//:repo_files)
# never scan them.
ignore_directories([
    ".git",
    ".claude/worktrees",
    "bazel-*",
    ".bazel-*",
    ".bazel_env",
    ".mise",
    ".venv",
    "tmp",
    "**/__pycache__",
    "**/.*_cache",
    "**/.hypothesis",
    ".vale/Google",
    ".vale/write-good",
    ".vale/proselint",
    ".vale/ai-tells*",
    ".obsidian",
])
