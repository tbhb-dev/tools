"""Root module for building and checking tbhb-dev/tbhb-dev-tools."""

module(name = "tbhb_dev_tools")

# Shared gate rules. Not on the BCR, so they come from Git, pinned to a
# commit on rules' main. To build against a local clone, put
# `common --override_module=tbhb_rules=/path/to/rules` in .bazelrc.user.
bazel_dep(name = "tbhb_rules", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules",
    commit = "064ef30fbe27cc8e4989b401a012113eda433079",
    remote = "https://github.com/tbhb-dev/rules.git",
)

# The Python checks, a nested module of the same repository, built from
# uv.lock, at the same pin as tbhb_rules; locally,
# `common --override_module=tbhb_rules_python=/path/to/rules/python`.
bazel_dep(name = "tbhb_rules_python", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "tbhb_rules_python",
    commit = "064ef30fbe27cc8e4989b401a012113eda433079",
    remote = "https://github.com/tbhb-dev/rules.git",
    strip_prefix = "python",
)

# The Python environment: the interpreter .python-version names and every
# package uv.lock pins, as `uv sync` gives a checkout.
python = use_extension("@tbhb_rules_python//:extensions.bzl", "python", dev_dependency = True)
python.project()

# The tool binaries @tbhb_rules pins, so the bazel_env shims and CI name
# the same repositories and each tool keeps one pin.
tools = use_extension("@tbhb_rules//pins:extensions.bzl", "tools")
use_repo(
    tools,
    "tbhb_rules_actionlint",
    "tbhb_rules_cog",
    "tbhb_rules_editorconfig_checker",
    "tbhb_rules_gitleaks",
    "tbhb_rules_rumdl",
    "tbhb_rules_ryl",
    "tbhb_rules_shellcheck",
    "tbhb_rules_shfmt",
    "tbhb_rules_tombi",
    "tbhb_rules_vale",
    "tbhb_rules_zizmor",
)

# Dev dependencies: tooling that only this workspace needs.
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0", dev_dependency = True)

# Stable paths and PATH shims (.bazel_env/bin) for the Bazel-pinned tools,
# which git hooks and editors call without starting Bazel.
bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)

# Pinned copies of the SchemaStore schemas that pyproject.toml's embedded
# tombi schema refers to by URL, so //:tombi_test validates offline. Pinned
# to a SchemaStore commit, because www.schemastore.org serves whatever is
# current and its digests drift.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

_SCHEMASTORE = "https://raw.githubusercontent.com/SchemaStore/schemastore/f0e072bb85076fcae82bebf058cf86520d4ea450/src/schemas/json/"

http_file(
    name = "schemastore_uv",
    dev_dependency = True,
    sha256 = "accd72042015703861297d12c682e0d9c35f435506acf942874927bb367ccdf7",
    url = _SCHEMASTORE + "uv.json",
)

http_file(
    name = "schemastore_partial_pytest",
    dev_dependency = True,
    sha256 = "15894b3b37e0ae60b79869da43b9e26790bc1198d645586ca8447246c23f9ac4",
    url = _SCHEMASTORE + "partial-pytest.json",
)

http_file(
    name = "schemastore_ruff",
    dev_dependency = True,
    sha256 = "d543216c52a7bd33325de767ebba8b410162302bce2cdc8980662e0bc06984be",
    url = _SCHEMASTORE + "ruff.json",
)

# The Vale style packages .vale.ini lists under Packages, pinned by digest so
# //:vale_test syncs them offline. Keep the URLs in step with .vale.ini.

http_file(
    name = "vale_google",
    dev_dependency = True,
    downloaded_file_path = "Google.zip",
