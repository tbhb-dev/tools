{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pr",
    "commit_id",
    "verdict",
    "reviewer",
    "builders",
    "findings"
  ],
  "properties": {
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "maxLength": 40,
      "description": "The exact head commit this verdict covers."
    },
    "verdict": {
      "enum": [
        "GO",
        "HOLD"
      ]
    },
    "reviewer": {
      "description": "A review from the provider that built a commit does not count for that commit; the later checker enforces this rule because schemas cannot check it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "harness",
        "model",
        "run"
      ],
      "properties": {
        "provider": {
          "enum": [
            "openai",
            "google",
            "anthropic"
          ]
        },
        "harness": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "run": {
          "type": "string"
        }
      }
    },
    "builders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "provider"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$",
            "maxLength": 40
          },
          "provider": {
            "enum": [
              "openai",
              "google",
              "anthropic"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "location",
          "summary"
        ],
        "properties": {
          "class": {
            "enum": [
              "BLOCK",
              "TECH-DEBT",
              "SECURITY-DEBT"
            ]
          },
          "location": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "HOLD"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "contains": {
              "properties": {
                "class": {
                  "const": "BLOCK"
                }
              },
              "required": [
                "class"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "GO"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "class": {
                    "const": "BLOCK"
                  }
                },
                "required": [
                  "class"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
