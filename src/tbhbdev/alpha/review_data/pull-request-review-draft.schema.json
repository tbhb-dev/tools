{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pr",
    "commit_id",
    "event"
  ],
  "properties": {
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "maxLength": 40
    },
    "event": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "COMMENT"
      ]
    }
  }
}
