{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#e668310ca3b5c74f42f8d49cea181f8b5e29a6d8", // main
    "github>tbhb-dev/renovate-config//bazel.json5#e668310ca3b5c74f42f8d49cea181f8b5e29a6d8", // main
    "github>tbhb-dev/renovate-config//python.json5#e668310ca3b5c74f42f8d49cea181f8b5e29a6d8", // main
  ],

  // tbhbdev: one Bazel module and one uv project, no Go, so no go.json5.
  // Nothing local is needed beyond the presets.
}
