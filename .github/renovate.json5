{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The presets track tbhb-dev/renovate-config's main branch, pinned by
  // commit; Renovate bumps the pins (the "renovate-config" group).
  extends: [
    "github>tbhb-dev/renovate-config//default.json5#6fc408cfec75871cd01b04bf1396e4f82c7fc792", // main
    "github>tbhb-dev/renovate-config//bazel.json5#6fc408cfec75871cd01b04bf1396e4f82c7fc792", // main
    "github>tbhb-dev/renovate-config//python.json5#6fc408cfec75871cd01b04bf1396e4f82c7fc792", // main
  ],

  // tbhbdev: one Bazel module and one uv project, no Go, so no go.json5.
  // Nothing local is needed beyond the presets.
}
